{
  "name": "busy-signal",
  "author": "lumine-code",
  "description": "Show a busy signal in the status bar.",
  "repository": "https://github.com/lumine-code/busy-signal",
  "bugs": {
    "url": "https://github.com/lumine-code/busy-signal/issues"
  },
  "keywords": [
    "status-bar",
    "indicator",
    "progress",
    "background",
    "loading",
    "spinner"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "atom": ">=1.100.0 <2.0.0"
  },
  "main": "./lib/index",
  "scripts": {
    "test": "cd ../lumine && npm run test:only -- ../busy-signal/spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "consumedServices": {
    "status-bar": {
      "versions": {
        "^1.0.0": "consumeStatusBar"
      }
    }
  },
  "providedServices": {
    "busy-signal": {
      "versions": {
        "1.0.0": "providerRegistry"
      }
    },
    "background-signal": {
      "versions": {
        "1.0.0": "provideBackgroundSignal"
      }
    },
    "atom-ide-busy-signal": {
      "versions": {
        "1.0.0": "provideBusySignal"
      }
    }
  },
  "dependencies": {
    "@lumine-code/select-list": "https://github.com/lumine-code/select-list.git#fbbc2d9660db6a2ff676c7a3baf7536f96ec34e6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.6"
  },
  "configSchema": {
    "showBackground": {
      "title": "Show Background Zone",
      "description": "Show the zone listing long-running background processes next to the busy signal.",
      "type": "boolean",
      "default": true
    },
    "debug": {
      "title": "Debug",
      "description": "Log busy-signal diagnostic messages to the developer console.",
      "type": "boolean",
      "default": false
    }
  }
}
